Disjointness.disjointness_lower_bound.{u_1, u_2, u_3} {n : ℕ} {R : Type u_1} {SA : Type u_2} {SB : Type u_3} [Fintype R]
  [Fintype SA] [Fintype SB] (p : Disjointness.Protocol (Disjointness.Bits n) (Disjointness.Bits n) R SA SB)
  (hc : p.Correct Disjointness.disj (1 / 3)) : Disjointness.lowerBoundConstant * ↑n ≤ ↑p.cost
Disjointness.disjointness_lower_bound_of_length.{u_1, u_2, u_3} {n : ℕ} {R : Type u_1} {SA : Type u_2} {SB : Type u_3}
  [Fintype R] [Fintype SA] [Fintype SB] (p : Disjointness.Protocol (Disjointness.Bits n) (Disjointness.Bits n) R SA SB)
  (c : ℕ) (h : ∀ (x y : Disjointness.Bits n) (r : R) (a : SA) (b : SB), ((p.tree r).run (x, a) (y, b)).1.length ≤ c)
  (hc : p.Correct Disjointness.disj (1 / 3)) : Disjointness.lowerBoundConstant * ↑n ≤ ↑c
Disjointness.random_tape_disjointness_lower_bound.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ] {n c : ℕ}
  (behavior : Ω → Disjointness.BoundedTree.Code (Disjointness.Bits n) (Disjointness.Bits n) c)
  (hm : Measurable behavior)
  (hc :
    ∀ (x y : Disjointness.Bits n),
      μ.real {ω | ((Disjointness.BoundedTree.toTree (behavior ω)).run x y).2 ≠ Disjointness.disj x y} ≤ 1 / 3) :
  Disjointness.lowerBoundConstant * ↑n ≤ ↑c
Disjointness.random_tree_disjointness_lower_bound.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ] {n : ℕ}
  (trees : Ω → Disjointness.Tree (Disjointness.Bits n) (Disjointness.Bits n)) (c : ℕ)
  (hm : Measurable fun ω => Disjointness.BoundedTree.encode c (trees ω))
  (hlen : ∀ (ω : Ω) (x y : Disjointness.Bits n), ((trees ω).run x y).1.length ≤ c)
  (hc : ∀ (x y : Disjointness.Bits n), μ.real {ω | ((trees ω).run x y).2 ≠ Disjointness.disj x y} ≤ 1 / 3) :
  Disjointness.lowerBoundConstant * ↑n ≤ ↑c
def Disjointness.BoundedTree.Code : Type → Type → ℕ → Type :=
fun X Y x => Nat.brecOn x (Disjointness.BoundedTree.Code._f X Y)
