def Disjointness.FiniteLowerBoundClaim : Prop :=
∃ a,
  0 < a ∧
    ∃ n₀,
      ∀ (n : ℕ),
        n₀ ≤ n →
          ∀ (R SA SB : Type) (x : Fintype R) (x_1 : Fintype SA) (x_2 : Fintype SB)
            (p : Disjointness.Protocol (Disjointness.Bits n) (Disjointness.Bits n) R SA SB),
            p.Correct Disjointness.disj (1 / 3) → a * ↑n ≤ ↑p.cost
