def Disjointness.Protocol.informationCost.{u_1, u_2, u_3, u_4, u_5, u_6} : {D : Type u_1} →
  {X : Type u_2} →
    {Y : Type u_3} →
      {R : Type u_4} →
        {SA : Type u_5} →
          {SB : Type u_6} →
            [Fintype D] →
              [Fintype X] →
                [Fintype Y] →
                  [Fintype R] →
                    [Fintype SA] →
                      [Fintype SB] →
                        [MeasurableSpace D] →
                          [MeasurableSpace X] →
                            [MeasurableSpace Y] →
                              [MeasurableSpace R] →
                                [MeasurableSpace SA] →
                                  [MeasurableSpace SB] → Disjointness.Protocol X Y R SA SB → PMF (D × X × Y) → ℝ :=
fun {D} {X} {Y} {R} {SA} {SB} [Fintype D] [Fintype X] [Fintype Y] [Fintype R] [Fintype SA] [Fintype SB]
    [MeasurableSpace D] [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace R] [MeasurableSpace SA]
    [MeasurableSpace SB] p μ =>
  I[fun s => s.1.2 : p.communicated|Disjointness.Protocol.conditioning;(p.executionLaw μ).toMeasure]
def Disjointness.Protocol.bjksInformationCost.{u_4, u_5, u_6} : {R : Type u_4} →
  {SA : Type u_5} →
    {SB : Type u_6} →
      [Fintype R] →
        [Fintype SA] →
          [Fintype SB] →
            [MeasurableSpace R] →
              [MeasurableSpace SA] →
                [MeasurableSpace SB] →
                  {n : ℕ} → Disjointness.Protocol (Disjointness.Bits n) (Disjointness.Bits n) R SA SB → ℝ :=
fun {R} {SA} {SB} [Fintype R] [Fintype SA] [Fintype SB] [MeasurableSpace R] [MeasurableSpace SA] [MeasurableSpace SB]
    {n} p =>
  p.informationCost (Disjointness.Switch.law n)
Disjointness.Protocol.bjksInformationCost_le.{u_4, u_5, u_6} {R : Type u_4} {SA : Type u_5} {SB : Type u_6} [Fintype R]
  [Fintype SA] [Fintype SB] [MeasurableSpace R] [DiscreteMeasurableSpace R] [MeasurableSpace SA]
  [DiscreteMeasurableSpace SA] [MeasurableSpace SB] [DiscreteMeasurableSpace SB] {n : ℕ}
  (p : Disjointness.Protocol (Disjointness.Bits n) (Disjointness.Bits n) R SA SB) :
  p.bjksInformationCost ≤ ↑p.cost * Real.log 2
