module

public import Disjointness.Hellinger
public import Disjointness.Switch

/-! Finite-channel expressions for PFR information and a fair binary input bound. -/

@[expose] public section

open MeasureTheory ProbabilityTheory Real
open scoped ENNReal

namespace Disjointness.Channel

open FiniteLaw Hellinger

variable {A B D : Type*} [Fintype A] [Fintype B] [Fintype D]
  [MeasurableSpace A] [DiscreteMeasurableSpace A]
  [MeasurableSpace B] [DiscreteMeasurableSpace B]
  [MeasurableSpace D] [DiscreteMeasurableSpace D]

noncomputable def information (w : PMF A) (K : A → PMF B) : ℝ :=
  mutualInfo Prod.fst Prod.snd (joint w K).toMeasure

/-- A finite average of actual PFR mutual information, not an assumed information functional. -/
noncomputable def conditional (w : PMF D) (q : D → PMF A) (K : A → PMF B) : ℝ :=
  ∑ d, mass w d * information (q d) K

omit [MeasurableSpace A] [DiscreteMeasurableSpace A] [MeasurableSpace B] [DiscreteMeasurableSpace B] in
theorem joint_map_snd (w : PMF A) (K : A → PMF B) :
    (joint w K).map Prod.snd = w.bind K := by
  rw [joint_eq_bind, PMF.map_bind]
  simp only [PMF.map_comp, Function.comp_def]
  change w.bind (fun a ↦ (K a).map id) = _
  simp only [PMF.map_id]

theorem entropy_pmf (p : PMF A) : entropy id p.toMeasure = ∑ a, negMulLog (mass p a) := by
  rw [entropy_eq_sum]
  simp only [Measure.map_id, measureReal_def,
    PMF.toMeasure_apply_singleton _ _ (.singleton _), tsum_fintype, mass]

theorem information_eq_entropy (w : PMF A) (K : A → PMF B) :
    information w K = entropy id (w.bind K).toMeasure - ∑ a, mass w a * entropy id (K a).toMeasure := by
  have : FiniteRange (Prod.fst : A × B → A) := ⟨Set.finite_range _⟩
  have : FiniteRange (Prod.snd : A × B → B) := ⟨Set.finite_range _⟩
  unfold information
  rw [mutualInfo_eq_entropy_sub_condEntropy' (X := (Prod.fst : A × B → A))
      (Y := (Prod.snd : A × B → B)) (show Measurable (Prod.fst : A × B → A) from measurable_fst)
      (show Measurable (Prod.snd : A × B → B) from measurable_snd) (joint w K).toMeasure,
    condEntropy_eq_sum_fintype (Prod.snd : A × B → B) (Prod.fst : A × B → A)
      (joint w K).toMeasure measurable_fst]
  have hm : entropy (Prod.snd : A × B → B) (joint w K).toMeasure =
      entropy id (w.bind K).toMeasure := by
    rw [entropy_def, PMF.toMeasure_map _ _ measurable_snd, joint_map_snd,
      entropy_def, Measure.map_id]
  rw [hm]
  congr 1
  apply Finset.sum_congr rfl
  intro a _
  simp only [measureReal_def, joint_fiber]
  by_cases ha : w a = 0
  · simp [ha, mass]
  · rw [joint_cond_fst _ _ _ ha, joint_const_toMeasure]
    simp only [entropy_def, Measure.map_snd_prod, measure_univ, one_smul, Measure.map_id, mass]

omit [MeasurableSpace A] [DiscreteMeasurableSpace A]
  [MeasurableSpace B] [DiscreteMeasurableSpace B] in
/-- Finite expectation is invariant under pushing the distribution forward. -/
theorem sum_mass_map (w : PMF A) (f : A → B) (g : B → ℝ) :
    ∑ b, mass (w.map f) b * g b = ∑ a, mass w a * g (f a) := by
  classical
  have hm (b : B) : mass (w.map f) b = ∑ a, if b = f a then mass w a else 0 := by
    rw [mass, PMF.map_apply, tsum_fintype, ENNReal.toReal_sum]
    · apply Finset.sum_congr rfl
      intro a _
      split_ifs <;> simp [mass]
    · intro a _
      split_ifs
      · exact w.apply_ne_top a
      · simp
  simp_rw [hm, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a _
  simp [ite_mul]

omit [MeasurableSpace A] [DiscreteMeasurableSpace A]
  [Fintype B] [MeasurableSpace B] [DiscreteMeasurableSpace B] in
theorem event_mass (p : PMF A) (f : A → B) (b : B) [DecidableEq B] :
    mass (p.map f) b = ∑ a ∈ Finset.univ.filter (fun a ↦ f a = b), mass p a := by
  classical
  rw [mass, PMF.map_apply, tsum_fintype, ENNReal.toReal_sum]
  · simp only [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro a _
    by_cases h : f a = b
    · simp [h, mass]
    · simp [h, Ne.symm h]
  · intro a _
    split_ifs
    · exact p.apply_ne_top a
    · simp

/-- The channel's information only depends on its actual input, even if that
input was generated by a non-injective deterministic map. -/
theorem information_map (w : PMF A) (f : A → D) (K : D → PMF B) :
    information (w.map f) K = information w (K ∘ f) := by
  rw [information_eq_entropy, information_eq_entropy, PMF.bind_map, sum_mass_map]
  rfl

theorem entropy_map_injective (p : PMF A) (f : A → B) (hf : Function.Injective f) :
    entropy id (p.map f).toMeasure = entropy id p.toMeasure := by
  rw [entropy_def, Measure.map_id, ← PMF.toMeasure_map _ _ .of_discrete]
  exact entropy_comp_of_injective p.toMeasure measurable_id f hf

theorem information_map_output (w : PMF A) (K : A → PMF B) (f : B → D)
    (hf : Function.Injective f) :
    information w (fun a ↦ (K a).map f) = information w K := by
  rw [information_eq_entropy, information_eq_entropy, ← PMF.map_bind,
    entropy_map_injective _ f hf]
  simp_rw [entropy_map_injective _ f hf]

omit [MeasurableSpace A] [DiscreteMeasurableSpace A]
  [MeasurableSpace B] [DiscreteMeasurableSpace B] [Fintype B] in
theorem mass_bind (w : PMF A) (K : A → PMF B) (b : B) :
    mass (w.bind K) b = ∑ a, mass w a * mass (K a) b := by
  rw [mass, PMF.bind_apply, tsum_fintype, ENNReal.toReal_sum
    (fun a _ ↦ ENNReal.mul_ne_top (w.apply_ne_top a) ((K a).apply_ne_top b))]
  simp only [ENNReal.toReal_mul, mass]

theorem conditional_eq_condMutualInfo (w : PMF D) (q : D → PMF A) (K : A → PMF B) :
    conditional w q K = condMutualInfo (fun s : D × (A × B) ↦ s.2.1)
      (fun s ↦ s.2.2) Prod.fst (joint w (fun d ↦ joint (q d) K)).toMeasure := by
  rw [condMutualInfo_eq_sum' measurable_fst]
  unfold conditional
  apply Finset.sum_congr rfl
  intro d _
  simp only [measureReal_def, joint_fiber]
  by_cases hd : w d = 0
  · simp [hd, mass]
  · rw [joint_cond_fst _ _ _ hd, joint_const_toMeasure]
    congr 1
    apply IdentDistrib.mutualInfo_eq
    refine ⟨.of_discrete, .of_discrete, ?_⟩
    change (joint (q d) K).toMeasure.map id =
      ((PMF.pure d).toMeasure.prod (joint (q d) K).toMeasure).map Prod.snd
    simp

omit [Fintype B] [MeasurableSpace B] [DiscreteMeasurableSpace B] in
theorem fair_bind_mass (K : Bool → PMF B) (b : B) :
    mass (Switch.fair.bind K) b = (mass (K false) b + mass (K true) b) / 2 := by
  rw [mass, PMF.bind_apply, tsum_fintype]
  simp only [Fintype.sum_bool, Switch.fair_apply]
  rw [ENNReal.toReal_add (ENNReal.mul_ne_top (by simp) ((K true).apply_ne_top b))
    (ENNReal.mul_ne_top (by simp) ((K false).apply_ne_top b))]
  simp only [ENNReal.toReal_mul, ENNReal.toReal_inv, ENNReal.toReal_ofNat, mass]
  ring

@[simp] theorem fair_mass (b : Bool) : mass Switch.fair b = 1 / 2 := by
  simp [mass, Switch.fair_apply]

/-- Mutual information of a fair selector is exactly Jensen--Shannon divergence. -/
theorem information_fair (K : Bool → PMF B) :
    information Switch.fair K = jensenShannon (K false) (K true) := by
  rw [information_eq_entropy]
  simp_rw [entropy_pmf]
  simp only [Fintype.sum_bool, fair_mass]
  simp_rw [fair_bind_mass]
  simp only [jensenShannon, Finset.sum_sub_distrib, ← Finset.sum_div,
    Finset.sum_add_distrib]
  ring

theorem sqDist_le_two_information_fair (K : Bool → PMF B) :
    sqDist (K false) (K true) ≤ 2 * information Switch.fair K := by
  rw [information_fair]
  exact sqDist_le_two_jensenShannon _ _

end Disjointness.Channel
