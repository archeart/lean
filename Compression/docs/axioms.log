def BBCR.ExternalCompressionClaim : Prop :=
∃ K,
  0 < K ∧
    ∀ (X Y R SA SB : Type) [inst : Fintype X] [inst_1 : Fintype Y] [inst_2 : Fintype R] [Fintype SA] [Fintype SB]
      [inst_5 : MeasurableSpace X] [DiscreteMeasurableSpace X] [inst_7 : MeasurableSpace Y] [DiscreteMeasurableSpace Y]
      [inst_9 : MeasurableSpace R] [DiscreteMeasurableSpace R] [inst_11 : MeasurableSpace SA]
      [DiscreteMeasurableSpace SA] [inst_13 : MeasurableSpace SB] [DiscreteMeasurableSpace SB]
      (p : Disjointness.Protocol X Y R SA SB) (μ : PMF (X × Y)) (α : ℝ),
      0 < α →
        α ≤ 1 / 2 → ∃ s, s.Simulates μ α ∧ ↑s.cost ≤ BBCR.compressionBudget K (BBCR.externalInformation p μ) p.cost α
